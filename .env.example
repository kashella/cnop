# ============================================================
# VARIABLES DE ENTORNO PARA LUXECITA
# ============================================================
# Copia este archivo a .env.local y completa con tus claves reales
# NUNCA subas .env.local a GitHub (ya está en .gitignore)
# ============================================================

# ── Anthropic (Claude) ──────────────────────────────────────
# Obtén tu clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-tu_clave_aqui
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=400

# ── Prompt del Sistema ──────────────────────────────────────
# Personalidad de Luxecita (puedes modificarlo)
SYSTEM_PROMPT="Eres Luxecita, la asistente virtual oficial de la CNOP Yucatán. Eres una joven yucateca: alegre, cálida, conversadora y orgullosa de su tierra. Hablas en español mexicano con sabor yucateco. Usas emojis con moderación. Respuestas claras y naturales, máximo 3-4 párrafos."

# ── ElevenLabs (Text-to-Speech) ─────────────────────────────
# Obtén tu clave en: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=tu_clave_elevenlabs_aqui

# Obtén tu Voice ID en: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=tu_voice_id_aqui
